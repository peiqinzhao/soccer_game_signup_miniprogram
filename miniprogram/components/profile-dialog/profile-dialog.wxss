.pd-center { display: flex; flex-direction: column; align-items: center; margin: 28rpx 0 20rpx; }
.pd-avatar { width: 140rpx; height: 140rpx; padding: 0; margin: 0 0 12rpx; border-radius: 50%; background: #f0f0f0; overflow: hidden; line-height: 1; }
.pd-avatar::after { border: none; }
.pd-avatar-img { width: 140rpx; height: 140rpx; }
.pd-avatar-ph { width: 140rpx; height: 140rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #888; }
.pd-input { border: 2rpx solid #ddd; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 30rpx; }
