<view class="page" wx:if="{{ready}}">
  <view class="card">
    <view class="field">
      <text class="field-label">球队名称</text>
      <input class="field-value" value="{{name}}" data-key="name" bindinput="onInput" placeholder="如：湾区养生足球" maxlength="30" />
    </view>
    <view class="field">
      <text class="field-label">Venmo 收款账号</text>
      <input class="field-value" value="{{venmo}}" data-key="venmo" bindinput="onInput" placeholder="@your-venmo" />
    </view>
    <view class="hint">罚款提示里会显示这个账号</view>
  </view>

  <view class="card" wx:if="{{clubId}}">
    <view class="card-title">默认规则</view>
    <view class="hint mb">只影响之后新发起的比赛</view>
    <picker range="{{tzLabels}}" value="{{tzIndex}}" data-key="tzIndex" bindchange="onPick">
      <view class="field"><text class="field-label">默认时区</text><text class="field-value small">{{tzLabels[tzIndex]}} ›</text></view>
    </picker>
    <picker range="{{ratingModes}}" value="{{ratingIndex}}" data-key="ratingIndex" bindchange="onPick">
      <view class="field"><text class="field-label">自评等级</text><text class="field-value small">{{ratingModes[ratingIndex]}} ›</text></view>
    </picker>
    <view wx:if="{{ratingIndex === 1}}" class="field">
      <text class="field-label">档位（逗号分隔）</text>
      <input class="field-value" value="{{ratingLabels}}" data-key="ratingLabels" bindinput="onInput" placeholder="入门，中级，高手" />
    </view>
    <block wx:if="{{ratingIndex === 2}}">
      <view class="field">
        <text class="field-label">最低 / 最高 / 间隔</text>
        <view class="row">
          <input type="digit" value="{{ratingMin}}" data-key="ratingMin" bindinput="onInput" style="width:90rpx; text-align:center;" />
          <text class="sub">–</text>
          <input type="digit" value="{{ratingMax}}" data-key="ratingMax" bindinput="onInput" style="width:90rpx; text-align:center;" />
          <text class="sub">每</text>
          <input type="digit" value="{{ratingStep}}" data-key="ratingStep" bindinput="onInput" style="width:90rpx; text-align:center;" />
        </view>
      </view>
    </block>
    <view wx:if="{{ratingIndex > 0}}" class="hint">成员可以在球队页或比赛页给自己选等级，名单上会显示，方便看出水平是否均衡。例：网球 1.0–7.0 每 0.5；羽毛球 1–10 每 1</view>
    <view class="field">
      <text class="field-label">启用罚款</text>
      <switch checked="{{finesEnabled}}" data-key="finesEnabled" bindchange="onSwitch" color="#111" />
    </view>
    <view wx:if="{{!finesEnabled}}" class="hint">关闭后不产生任何罚款（迟到、未到、临时取消都不罚），也不会因未付罚款拦截报名；基金账本照常可用</view>
    <view wx:if="{{finesEnabled}}" class="field">
      <text class="field-label">罚款金额（$）</text>
      <input class="field-value" type="digit" value="{{fineDollars}}" data-key="fineDollars" bindinput="onInput" />
    </view>
    <view wx:for="{{numFields}}" wx:key="key" class="field">
      <text class="field-label">{{item.label}}（{{item.unit}}）</text>
      <input class="field-value" type="number" value="{{nums[item.key]}}" data-key="nums.{{item.key}}" bindinput="onInput" />
    </view>
    <picker mode="time" value="{{cancelDeadlineTime}}" data-key="cancelDeadlineTime" bindchange="onPick">
      <view class="field"><text class="field-label">取消不转发罚款截止时刻</text><text class="field-value">{{cancelDeadlineTime}} ›</text></view>
    </picker>
    <view class="field">
      <text class="field-label">默认开启到场签到</text>
      <switch checked="{{checkinEnabled}}" data-key="checkinEnabled" bindchange="onSwitch" color="#111" />
    </view>
    <view class="hint">关掉后新发起的比赛默认不需要签到、不判迟到；单场发起时仍可打开</view>
    <view class="field">
      <text class="field-label">默认标签</text>
      <input class="field-value" value="{{defaultTagsText}}" data-key="defaultTagsText" bindinput="onInput" placeholder="如：已付款" maxlength="30" />
    </view>
    <view class="hint">新发起比赛时自动带上，最多 3 个，用逗号分隔</view>
  </view>

  <button class="btn" bindtap="save">{{clubId ? '保存' : '创建球队'}}</button>
  <view wx:if="{{clubId && isOwner}}" class="mt">
    <button class="btn btn-danger" bindtap="onArchiveClub">删除球队</button>
    <view class="hint" style="text-align:center;">删除后所有成员都看不到这个球队和它的比赛，只有创建者可以操作</view>
  </view>
</view>

<profile-dialog show="{{showProfile}}" bind:done="onProfileDone" bind:cancel="onProfileCancel" />
